@model List<string>

<style>
    body {
        padding-bottom: 0 !important;
    }
</style>

<h1>📸 My Photo Album</h1>

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <input type="file" id="fileInput" name="file" required onchange="previewImage()" />
    <button type="submit">Upload</button>
</form>

<!-- Preview -->
<div id="previewBox"></div>

<hr/>

<!-- Image Slider (Hidden by default) -->
<div class="slider-modal" id="sliderModal">
    <button class="slider-close" onclick="closeSlider()">✕</button>
    <div class="slider-container">
        <div class="slider">
            <button class="slider-btn prev" onclick="prevSlide()">❮</button>
            <div class="slider-wrapper">
                <div class="slider-track" id="sliderTrack">
                    @foreach (var img in Model)
                    {
                        <img src="/images/@img" alt="@img" class="slide" data-img="@img" />
                    }
                </div>
            </div>
            <button class="slider-btn next" onclick="nextSlide()">❯</button>
        </div>
        <div class="slider-controls">
            <div class="slider-info">
                <p>Image <span id="currentSlide">1</span> of <span id="totalSlides">@Model.Count</span></p>
                <small style="display: block; margin-top: 5px; opacity: 0.8;">💡 Drag to pan when zoomed | Scroll to zoom</small>
            </div>
            <div class="zoom-controls">
                <button class="zoom-btn" onclick="zoomIn()" title="Zoom In">🔍+</button>
                <span id="zoomLevel">100%</span>
                <button class="zoom-btn" onclick="zoomOut()" title="Zoom Out">🔍−</button>
                <button class="zoom-btn" onclick="resetZoom()" title="Reset Zoom">↺</button>
            </div>
        </div>
    </div>
</div>



<div class="gallery">
    @foreach (var img in Model)
    {
        <div class="card">
            <img src="/images/@img" onclick="openSlider('@img')" class="card-img" />

            <input type="text" placeholder="Add caption..." 
                   oninput="saveCaption('@img', this.value)" />

            <button onclick="likeImage('@img')" class="like-btn">❤️</button>

            <p id="likes-@img"></p>

            <div class="actions">
                <a href="/Home/Delete?name=@img">❌ Delete</a>
            </div>
        </div>
    }
</div>

<!-- Modal -->
<div id="modal" class="modal" onclick="closeModal()">
    <img id="modalImg">
</div>

<link rel="stylesheet" href="~/css/site.css" />
<script src="~/js/site.js"></script>