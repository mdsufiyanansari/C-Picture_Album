@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="policy-container">
    <h1>🔒 Privacy Policy</h1>
    
    <section class="policy-section">
        <h2>Data Protection</h2>
        <p>
            Your privacy is important to us. PhotoAlbumApp is committed to protecting your personal data. 
            The images you upload are stored locally on our server and are not shared with third parties without your consent.
        </p>
    </section>

    <section class="policy-section">
        <h2>What Information We Collect</h2>
        <ul>
            <li>Images and photos you upload</li>
            <li>Captions and descriptions for your photos</li>
            <li>User preferences stored in local browser storage</li>
            <li>Like counts for your images (stored locally)</li>
        </ul>
    </section>

    <section class="policy-section">
        <h2>How We Use Your Information</h2>
        <p>
            We use your information solely to:
        </p>
        <ul>
            <li>Display your photo album</li>
            <li>Allow you to manage and organize your images</li>
            <li>Store your preferences and captions</li>
            <li>Provide a better user experience</li>
        </ul>
    </section>

    <section class="policy-section">
        <h2>Data Storage</h2>
        <p>
            Most of your data is stored locally in your browser using localStorage:
        </p>
        <ul>
            <li>Captions are saved in your browser</li>
            <li>Like counts are tracked locally</li>
            <li>Images are stored on our server in the /images directory</li>
        </ul>
    </section>

    <section class="policy-section">
        <h2>Your Rights</h2>
        <p>
            You have the right to:
        </p>
        <ul>
            <li>Delete any image from your album</li>
            <li>Clear your local data by clearing browser cache</li>
            <li>Contact us with privacy concerns</li>
        </ul>
    </section>

    <section class="policy-section">
        <h2>Contact Us</h2>
        <p>
            If you have any questions about our privacy practices, please contact us at: <strong>privacy@photoalbumapp.com</strong>
        </p>
    </section>


</div>

<link rel="stylesheet" href="~/css/site.css" />
