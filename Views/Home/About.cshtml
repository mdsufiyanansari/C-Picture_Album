@{
    ViewData["Title"] = "About PhotoAlbumApp";
}

<div class="about-container">
    <h1>📸 About PhotoAlbumApp</h1>
    
    <section class="about-section">
        <h2>Welcome to PhotoAlbumApp</h2>
        <p>
            PhotoAlbumApp is a modern web application designed to help you organize, manage, and share your favorite photos. 
            Whether you're a photography enthusiast or just want a simple way to store and view your memories, we've got you covered.
        </p>
    </section>

    <section class="about-section">
        <h2>🎯 Our Mission</h2>
        <p>
            To provide a simple, user-friendly platform for managing your personal photo collection. 
            We believe that organizing photos should be easy and enjoyable, not complicated.
        </p>
    </section>

    <section class="about-section">
        <h2>✨ Features</h2>
        <ul>
            <li>📤 <strong>Upload Photos</strong> - Easily upload images to your album</li>
            <li>🖼️ <strong>Gallery View</strong> - Browse all your photos in a beautiful grid layout</li>
            <li>📽️ <strong>Image Slider</strong> - View your images in a smooth, fullscreen slider</li>
            <li>❤️ <strong>Like System</strong> - Mark your favorite photos with likes</li>
            <li>💬 <strong>Add Captions</strong> - Write descriptions for your memories</li>
            <li>🔍 <strong>Zoom Controls</strong> - Zoom in/out when viewing in slider mode</li>
            <li>🗑️ <strong>Delete Photos</strong> - Remove images from your album</li>
        </ul>
    </section>

    <section class="about-section">
        <h2>🛠️ Technology Stack</h2>
        <p>
            PhotoAlbumApp is built with modern web technologies:
        </p>
        <ul>
            <li><strong>Backend:</strong> ASP.NET Core with C#</li>
            <li><strong>Frontend:</strong> HTML, CSS, JavaScript</li>
            <li><strong>UI Framework:</strong> Bootstrap 5</li>
            <li><strong>Storage:</strong> Server-side file system & Browser localStorage</li>
        </ul>
    </section>

    <section class="about-section">
        <h2>❓ How to Use</h2>
        <ol>
            <li>Navigate to the <strong>Home</strong> page</li>
            <li>Click the file input to select an image</li>
            <li>Click <strong>Upload</strong> to save your photo</li>
            <li>View your photos in the gallery grid below</li>
            <li>Click any photo to open the fullscreen slider</li>
            <li>Add captions, likes, and manage your collection</li>
        </ol>
    </section>

    <section class="about-section">
        <h2>🎨 Tips & Tricks</h2>
        <ul>
            <li>Use arrow buttons in the slider to navigate between photos</li>
            <li>Press ESC key to close the slider quickly</li>
            <li>Use zoom buttons to get a closer look at your photos</li>
            <li>Add meaningful captions to remember the story behind each photo</li>
            <li>Your likes and captions are saved automatically in your browser</li>
        </ul>
    </section>

    <section class="about-section">
        <h2>📞 Support & Feedback</h2>
        <p>
            Have questions or suggestions? We'd love to hear from you!
        </p>
        <p>
            <strong>Email:</strong> support@photoalbumapp.com<br>
            <strong>Website:</strong> www.photoalbumapp.com
        </p>
    </section>

   
</div>

<link rel="stylesheet" href="~/css/site.css" />
